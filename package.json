{
  "name": "ferramenta-pwa",
  "private": true,
  "version": "1.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node src/backend/server.js",
    "install:backend": "npm install --prefix src/backend",

    "init": "npm install && npm run install:backend && npm run build",
    "start": "concurrently \"npm run server\" \"npm run preview\"",
    "start:full": "npm run init && npm run start"
  },
  "dependencies": {
    "@stripe/stripe-js": "^8.9.0",
    "firebase": "^12.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-precaching": "^7.4.1"
  }
}
